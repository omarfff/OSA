PORT=4021
OSA_PAY_TO=
OSA_PRICE_USD=0.01
# x402 defaults below are TESTNET ONLY. For Base mainnet use eip155:8453 and an explicit production facilitator.
OSA_NETWORK=eip155:84532
OSA_FACILITATOR_URL=https://x402.org/facilitator
OSA_LIVE_TIMEOUT_MS=5000
# Dodo Payments (live rail; disabled until merchant approval)
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID=
DODO_PAYMENTS_BASE_URL=https://live.dodopayments.com
DODO_RETURN_URL=

# OSA local-first AI router. Never commit real API keys.
OSA_OLLAMA_URL=http://127.0.0.1:11434
OSA_BRAIN_MODEL=qwen3.5:0.8b
OSA_AI_PROVIDER_ORDER=ollama,openai_compatible,gemini
# Any HTTPS OpenAI-compatible provider (OpenAI/OpenRouter/Groq/Together/etc.).
OSA_AI_REMOTE_URL=
OSA_AI_REMOTE_MODEL=
OSA_AI_REMOTE_API_KEY=
# Gemini is optional and requires an explicit current model name.
OSA_GEMINI_MODEL=
OSA_GEMINI_API_KEY=

# Agent Fabric gates. Leave both disabled by default.
# Set to 1 only for a controlled run that needs the capability.
OSA_AGENT_ALLOW_WRITE=0
OSA_AGENT_ALLOW_DISABLED=0

# Public receiving addresses. Safe to expose; private keys must never be placed in env files.
OSA_EVM_RECEIVE_ADDRESS=0x04e8930d13A6f6A258aA1488eeFa500ca8Cd9ebB
OSA_SOLANA_RECEIVE_ADDRESS=
OSA_SOLANA_OWNERSHIP_PROOF_REF=
OSA_TRON_RECEIVE_ADDRESS=TXzMju2v6QoevWaMkPaSwEuN6HbFibWW7o
OSA_BITCOIN_RECEIVE_ADDRESS=bc1qpg5zxqps9038vfgpjganvrf5pvq8ykk29ft9eq
