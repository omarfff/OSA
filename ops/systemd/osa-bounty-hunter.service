[Unit]
Description=OSA Autonomous Bounty Hunter
Documentation=https://github.com/omarfff/OSA/tree/main/ops/bounty-hunter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=osa-bounty
Group=osa-bounty
WorkingDirectory=/opt/osa-bounty-hunter
EnvironmentFile=/etc/osa-bounty-hunter.env
Environment=PYTHONUNBUFFERED=1
# Discovery and tested patch preparation run automatically. Public claiming is
# kept human-gated at the service boundary even if the env file drifts.
Environment=AUTO_PREPARE_FIX=true
Environment=AUTO_ATTEMPT=false
# Financial movement is fail-closed at the service boundary. Proposals and
# simulations may run, but this daemon cannot broadcast value-moving txs.
Environment=FINANCIAL_BROADCAST_ENABLED=false
Environment=OPENAI_MODEL=gpt-5.6-sol
ExecStartPre=/opt/osa-bounty-hunter/.venv/bin/python /opt/osa-bounty-hunter/bounty_hunter.py doctor
ExecStart=/opt/osa-bounty-hunter/.venv/bin/python /opt/osa-bounty-hunter/bounty_hunter.py daemon
Restart=on-failure
RestartSec=15s
TimeoutStartSec=90s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/osa-bounty-hunter
TasksMax=256
MemoryMax=2G
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
