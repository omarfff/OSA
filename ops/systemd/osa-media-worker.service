[Unit]
Description=OSA Faceless Media Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=osa-media
Group=osa-media
WorkingDirectory=/var/lib/osa-media
EnvironmentFile=/etc/osa/media-worker.env
ExecStart=/usr/bin/node /usr/local/lib/osa/media-worker.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StateDirectory=osa-media
StateDirectoryMode=0750
ReadWritePaths=/var/lib/osa-media
