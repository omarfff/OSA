# OSA Autonomous Bounty Hunter
# Production path: /etc/osa-bounty-hunter.env
# NEVER commit a populated secret file.

ENVIRONMENT=production
POLL_INTERVAL_SECONDS=300
STATE_DB=/var/lib/osa-bounty-hunter/state.db
WORK_ROOT=/var/lib/osa-bounty-hunter/workspaces
APPROVAL_DIR=/var/lib/osa-bounty-hunter/approvals

# GitHub / Algora
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10
GITHUB_DISCOVERY_ENABLED=false
GITHUB_SEARCH_QUERY='is:issue is:open label:"💎 Bounty"'
ALGORA_BASE=https://algora.io
ALGORA_ORGS=projectdiscovery
MIN_BOUNTY_USD=50
MAX_ACTIVE_ATTEMPTS=2
ATTEMPT_TTL_HOURS=96
MAX_EXISTING_ATTEMPTS=4
AUTO_ATTEMPT=false

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
AI_MIN_SCORE=78
MAX_REPO_CONTEXT_BYTES=120000
AUTO_PREPARE_FIX=true
SANDBOX_TIMEOUT_SECONDS=900
SANDBOX_ENABLED=true
BWRAP_BINARY=/usr/bin/bwrap

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase control plane. Used for centralized financial approval/audit as the
# pipeline is migrated away from local-only state.
SUPABASE_URL=https://jpnlmpqqtiwisxcsjwbm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APPROVAL_MAX_AGE_MINUTES=30

# Polygon
POLYGON_RPC=
POLYGON_CHAIN_ID=137
WALLET_ADDRESS=0x7A6F08C684f16B74BE7Ff499bB8A24a4EF3cf66b
COLD_WALLET_ADDRESS=0xB46151013A842bb1c0dCf70bF7c5788a222b20f4
PRIVATE_KEY=

# Polygon USDT was upgraded in place to USDT0 while retaining the contract.
USDT_TOKEN_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
WPOL_TOKEN_ADDRESS=0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270
UNISWAP_V3_ROUTER=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
UNISWAP_V3_QUOTER=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
UNISWAP_V3_FEES=100,500,3000,10000
SWAP_USDT_AMOUNT=5
SWAP_SLIPPAGE_BPS=150
MIN_POL_BALANCE=0.20
EMERGENCY_POL_BALANCE=0.03
SWEEP_THRESHOLD_USDT=50
USDT_OPERATIONAL_RESERVE=15
FINANCIAL_PROPOSAL_TTL_SECONDS=900
FINANCIAL_MONITOR_ENABLED=false

# Safety invariant: systemd additionally forces this OFF.
FINANCIAL_BROADCAST_ENABLED=false
LOG_LEVEL=INFO
